# ==============================================================================
# ConsentCare EHR — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' before running docker compose up.
# All passwords and secrets below are templates and must be replaced in production.

# --- Database Configuration (PostgreSQL 16) ---
POSTGRES_DB=consentcare
POSTGRES_USER=consentcare
POSTGRES_PASSWORD=replace-with-strong-db-password-min-16-chars
POSTGRES_PORT=5433

# --- Core Service & Security (Spring Boot 3.3.4) ---
# IMPORTANT: Generate a 64+ char random string (e.g. openssl rand -base64 48)
JWT_SECRET=replace-with-minimum-64-character-cryptographic-random-jwt-secret-key-32-bytes
JWT_EXPIRATION_MS=86400000
CORE_PORT=8081

# Initial Administrator Bootstrapping
ADMIN_EMAIL=admin@consentcare.local
ADMIN_PASSWORD=replace-with-strong-admin-password-Admin@12345
ADMIN_NAME=ConsentCare System Administrator

# CORS and Network
CORS_ALLOWED_ORIGINS=http://localhost:81,http://127.0.0.1:81,http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=/app/uploads

# --- Frontend (React 19 + Vite + Nginx) ---
FRONTEND_PORT=81

# --- Python Microservices Host Ports (Bound to 127.0.0.1) ---
RISK_PORT=8001
AGENT_PORT=8002

# --- AI Integration Architecture ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Optional Fallback Cloud Provider (Omit if using local Ollama only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
