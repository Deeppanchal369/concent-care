# ==============================================================================
# ConsentCare EHR — Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=consentcare
POSTGRES_USER=consentcare
POSTGRES_PASSWORD=consentcare

# ------------------------------------------------------------------------------
# Centralized Host Port Configuration (Host bindings -> Internal container ports)
# ------------------------------------------------------------------------------
# FRONTEND_PORT: Host port for Nginx serving the React SPA (maps to container port 80)
FRONTEND_PORT=81

# CORE_PORT: Host port for Spring Boot core API (maps to container port 8080)
# (Using 8081 on host to prevent conflicts with host 8080 used by system services)
CORE_PORT=8081

# RISK_PORT: Host port for Python FastAPI risk-service (maps to container port 8001)
RISK_PORT=8001

# AGENT_PORT: Host port for Python FastAPI agent-service (maps to container port 8002)
AGENT_PORT=8002

# POSTGRES_PORT: Host port for PostgreSQL database (maps to container port 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Spring Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=consentcare-super-secret-jwt-token-key-change-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# Bootstrap Development Administrator
ADMIN_EMAIL=admin@consentcare.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=ConsentCare System Administrator

# ------------------------------------------------------------------------------
# Internal Service Routing (Docker internal network DNS — DO NOT change to localhost)
# ------------------------------------------------------------------------------
RISK_SERVICE_URL=http://risk-service:8001
AGENT_SERVICE_URL=http://agent-service:8002

# Storage Configuration
UPLOAD_DIR=/app/uploads

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:81,http://127.0.0.1:81,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Phase 5: Artificial Intelligence & Document NLP Configuration
# ------------------------------------------------------------------------------
# AI_PROVIDER: 'ollama' (default local development) or 'gemini' (optional cloud fallback)
AI_PROVIDER=ollama

# Local Ollama Configuration (Host-to-container route)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

# Optional Cloud Gemini Configuration (server-side only, never exposed to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

